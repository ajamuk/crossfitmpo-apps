# Copia este archivo a .env y ajusta los valores
# Clave para firmar los tokens de sesión. CÁMBIALA por algo largo y aleatorio.
# Genera una con:  openssl rand -hex 32
JWT_SECRET=pon-aqui-una-clave-larga-y-aleatoria

# Puerto en el host donde se publica la app
PORT=3000

# Permitir registro de nuevos usuarios (true/false).
# Ponlo en false cuando ya hayas creado tus cuentas para cerrar el registro.
ALLOW_SIGNUP=true
